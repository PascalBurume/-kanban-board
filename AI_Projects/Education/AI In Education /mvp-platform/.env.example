# Mwalimu — copy to .env and fill in. Never commit the real .env.

# ---- required ----

# SQLite file, relative to prisma/.
DATABASE_URL="file:./dev.db"

# iron-session cookie encryption key. MUST be unique per deployment and at
# least 32 characters. Anyone who knows this value can mint an ADMIN session,
# so the placeholder that ships in src/lib/session.ts is rejected outright:
# a production build or boot fails rather than run with a public secret.
# Generate one with:  openssl rand -base64 48
SESSION_PASSWORD=""

# ---- optional: Ollama (Copilot, lesson authoring, RAG) ----
# Leave the defaults for a standard local install. The app degrades to a
# French 503 on these routes when Ollama is unreachable; nothing else breaks.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3n:e2b"
# Heavier model for maths-dense content refinement.
OLLAMA_MODEL_MATH="gemma3n:e4b"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_NUM_CTX="8192"

# ---- optional: deployment ----
# School servers often run a production build over plain HTTP on the LAN,
# where a Secure cookie would never be stored and login would silently fail.
# Set to 0 for those deployments.
SESSION_SECURE="1"
# Where lesson image uploads are written. Defaults to public/uploads.
# UPLOAD_DIR=""
