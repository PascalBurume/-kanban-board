# Local development uses SQLite (zero setup). Copy this file to .env.
DATABASE_URL="file:./dev.db"

# For production, switch the datasource provider in prisma/schema.prisma to
# "postgresql" and point DATABASE_URL at your Postgres instance, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/japanese_app?schema=public"

# --- AI features (OpenAI) -------------------------------------------------
# Required for /tutor, /write, /generate, /breakdown.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
