{
  "name": "mwalimu-mvp",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build:content": "node scripts/build-content.mjs && node scripts/build-exercises.mjs",
    "predev": "node scripts/build-content.mjs && node scripts/build-exercises.mjs && prisma generate",
    "dev": "next dev",
